# Base de datos remota (Upstash Redis / Vercel KV)
# En Vercel estas variables las inyecta la integración al conectar el store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa si usas Upstash directamente:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
DB_KEY=recovery-studio:db

# Aplicación
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Semilla del administrador (solo se usa al crear una base nueva)
ADMIN_EMAIL=recoverystudio7@gmail.com
ADMIN_PASSWORD=cambia-esta-clave
STUDIO_EMAIL=recoverystudio7@gmail.com
