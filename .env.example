# Base de datos remota (Upstash Redis / Vercel KV)
# En Vercel estas variables las inyecta la integración al conectar el store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa si usas Upstash directamente:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
DB_KEY=recovery-studio:db

# Aplicación
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Zona horaria del studio (Vercel ejecuta en UTC por defecto).
TZ=America/Santiago

# Semilla del administrador (solo se usa al crear una base nueva)
ADMIN_EMAIL=recoverystudio7@gmail.com
ADMIN_PASSWORD=cambia-esta-clave
STUDIO_EMAIL=recoverystudio7@gmail.com

# Notificaciones internas del panel (Resend + CallMeBot/Twilio)
RESEND_API_KEY=
# Remitente para avisos al administrador (puede ser onboarding@resend.dev).
RESEND_FROM=Recovery Studio <onboarding@resend.dev>
# Remitente verificado para correos a clientes (dominio propio en Resend).
RESEND_CLIENT_FROM=Recovery Studio <hola@tudominio.cl>
NOTIFY_EMAIL=recoverystudio7@gmail.com
CALLMEBOT_PHONE=+56900000000
CALLMEBOT_APIKEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+56900000000

# Crons diarios de Vercel (recordatorios y respaldo JSON)
CRON_SECRET=cambia-este-secreto
